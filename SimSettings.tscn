[node name="MeanSstSpin" type="SpinBox" parent="Frame/FrameMargin/FrameRows/Content/MeanSstRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(200, 40)
layout_mode = 2
tooltip_text = "所有海区统一的基准海温（℃）。默认 30.0 = 不偏移；调高 = 整体更暖、台风更容易增强。"
min_value = 20.0
max_value = 100.0
step = 0.5
value = 30.0
suffix = " ℃"
alignment = 2

