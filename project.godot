; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Typhoon"
config/version="1.1.1"
run/main_scene="res://TitleScreen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Const="*res://scripts/Constants.gd"
Game="*res://scripts/Game.gd"
GameSettings="*res://scripts/GameSettings.gd"
SimClock="*res://scripts/SimClock.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[gui]

; 全局默认字体：Noto Sans SC（OFL 1.1，随包分发）。导出后的 Web 版没有系统字体，
; 不设这个的话中文全是豆腐块。
theme/custom_font="res://assets/fonts/NotoSansSC-Regular.otf"
; Theme 只补 RichTextLabel 的粗体/斜体：引擎内置的 bold/italics 字体没有中日韩字形，
; 网页版里 [b]/[i] 的中文仍会是方框（Windows 版靠系统字体兜底所以看不出来）。
theme/custom="res://assets/theme/main_theme.tres"

[physics]

common/physics_ticks_per_second=30
3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
