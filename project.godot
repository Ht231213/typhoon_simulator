; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Typhoon"
config/version="1.3.0-beta.1"
run/main_scene="res://TitleScreen.tscn"
; 用户 2026-11-10（⑤）：限制最大 FPS，防止「暂停 / 回到主菜单」时没有 vsync 的机器上
; 引擎全速空转把 GPU 顶到 95%+（正常运行没问题，但空场景帧率可以冲到几百上千）。
run/max_fps=60
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Const="*res://scripts/Constants.gd"
Game="*res://scripts/Game.gd"
GameSettings="*res://scripts/GameSettings.gd"
SimClock="*res://scripts/SimClock.gd"
MusicManager="*res://scripts/MusicManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=782
; 2026-11-22 窗口尺寸下拉：改为 disabled（窗口像素 = UI 像素）。
; 换分辨率时侧栏/按钮/字号大小不变，只有地图区变大；
; 若保留 canvas_items，换尺寸会整体缩放 + 留黑边，与「不同窗口看不同大小地图」冲突。
window/stretch/mode="disabled"

[gui]

theme/default_theme_scale=1.31
theme/custom="res://assets/theme/main_theme.tres"
theme/custom_font="res://assets/fonts/NotoSansSC-Regular.otf"

[physics]

common/physics_ticks_per_second=30
3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="vulkan"
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
