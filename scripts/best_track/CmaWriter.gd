extends "res://scripts/best_track/TrackWriter.gd"
## CMA 最佳路径数据集格式（中国气象局热带气旋资料中心，tcdata.typhoon.org.cn）。
##
## 这里是从 `BestTrack.gd` **原样搬过来**的，Step 1 的要求是**输出逐字节不变**
## （黄金文件 `golden_cma.txt`，md5 c641059c…）。改动这个文件前先跑一遍 `_bt_golden` 对比。
##
## 规范里给的字段全部照搬，填不了的按用户决定处理：
##   · EEEE（我国编号）→ `0000`（真实文件里 1949 年那份也是这个值）
##   · OWD（沿海大风/南海最大风速）→ 每行末尾一个 `-`
##
## ⚠ 和真实数据的关键区别：本文件是**模拟器生成的**，开头有中英双语声明。

## 1 kt = 多少 m/s（CMA 的 WND 用 m/s）
const KT_TO_MS := 0.514444

## 变性阶段（= `int(Storm.Phase)`）：2 = 已经完全变性成温带气旋
const PHASE_EXTRATROPICAL := 2


func _init() -> void:
	id = "cma"
	extension = ".txt"


func preamble_lines() -> PackedStringArray:
	# 中英双语声明（用户要求：和真实数据区分开）
	return PackedStringArray([
		"# ============================================================",
		"# 本文件由「台风模拟器」生成，**不是真实观测资料**，不可用于科研或业务。",
		"# This file is generated by a TYPHOON SIMULATOR and is NOT real",
		"# observational data. Do not use it for research or operations.",
		"# 格式仿照 CMA 最佳路径数据集，但内容全部为模拟结果。",
		"# Format mimics the CMA Best Track dataset; all content is simulated.",
		"# ============================================================",
	])


func track_header_lines(t: Dictionary) -> PackedStringArray:
	return PackedStringArray([_header_line(t)])


func sample_line(s: Dictionary, _t: Dictionary, write_year: int) -> String:
	return _data_line(s, write_year)


## 头记录。用户决定：名字字段用规范写的 **20** 字符（真实文件里是 35）。
## 字段顺序和宽度（合计 58）：
##   AAAAA(5) BBBB(4) CCC(3) DDDD(4) EEEE(4) F(1) G(1) H(20) I(8)
func _header_line(t: Dictionary) -> String:
	var samples: Array = t["samples"]
	# BBBB = 年份后两位 + 两位编号。没有国际编号（没到 TS）时是 0000。
	var bbbb := 0
	if int(t["storm_number"]) > 0:
		bbbb = (int(t["birth_year"]) % 100) * 100 + (int(t["storm_number"]) % 100)
	var ccc := samples.size()
	var dddd := int(t["dep_number"])
	var eeee := 0                                  # 我国编号：我们填不了
	var f_code := int(t["end_code"])
	var g := 6
	var hh := str(t["name_en"]).substr(0, 20)
	# I...I = 数据集形成的日期。**按用户要求用游戏内时间**（不是系统时间）：
	#   游戏内年份计数 + 月 + 日，例如 00010815。
	#   ⚠ 文件名里的 YYMMDD 才是系统时间（见 BestTrackRecorder._pick_file_path）。
	var ii := "%04d%02d%02d" % [int(t["birth_year"]), int(t["birth_month"]), int(t["birth_day"])]
	return "%s %s %s %s %s %d %d %s %s" % [
		"66666",
		"%04d" % bbbb,
		"%3d" % ccc,
		"%04d" % dddd,
		"%04d" % eeee,
		f_code,
		g,
		hh.rpad(20, " "),
		ii,
	]


## GB/T 19201-2006 强度标记（按 m/s）。
## marker 是 CMA 专有概念，所以从 (kt, phase) **现算**，不再往 samples 里存
## （samples 只存物理量 + phase，IBTrACS 那边要用 phase 算 NATURE）。
func _marker(kt: float, phase: int) -> int:
	# 变性：第一个 9 表示变性完成
	if phase == PHASE_EXTRATROPICAL:
		return 9
	var ms := kt * KT_TO_MS
	if ms < 10.8:
		return 0
	if ms <= 17.1:
		return 1
	if ms <= 24.4:
		return 2
	if ms <= 32.6:
		return 3
	if ms <= 41.4:
		return 4
	if ms <= 50.9:
		return 5
	return 6


## 数据记录：
##   YYYYMMDDHH(10) I(1) LAT(3) LONG(4) PRES(4) WND(8) 然后把 OWD 写成 `-`
func _data_line(s: Dictionary, write_year: int) -> String:
	var yyyy := "%04d" % write_year
	var mm := "%02d" % int(s["month"])
	var dd := "%02d" % int(s["day"])
	var hh := "%02d" % int(s["hour"])
	var lat := int(roundf(float(s["lat"]) * 10.0))
	var lon := int(roundf(float(s["lon"]) * 10.0))
	var pres := int(roundf(float(s["pres"])))
	var ms := int(roundf(float(s["kt"]) * KT_TO_MS))
	# 规范：WND=9 表示 <10 m/s，WND=0 表示缺测
	if ms < 10:
		ms = 9
	var marker := _marker(float(s["kt"]), int(s.get("phase", 0)))
	var head := "%s%s%s%s %d %3d %4d %4d%8d" % [
		yyyy, mm, dd, hh, marker, lat, lon, pres, ms]
	return head + " -"
